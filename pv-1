<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PV ICSR Central Processing Dashboard</title>
    <!-- Dependencies: Bootstrap 5 CSS & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .sidebar { min-height: 100vh; background-color: #1e293b; color: #fff; }
        .sidebar .nav-link { color: #94a3b8; border-radius: 0.375rem; margin-bottom: 0.25rem; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background-color: #334155; color: #fff; }
        .card { border: none; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); margin-bottom: 1.5rem; }
        .card-header { background-color: #ffffff; border-bottom: 1px solid #e2e8f0; font-weight: 600; }
        .label-badge { font-size: 0.75rem; background-color: #e0f2fe; color: #0369a1; padding: 0.2rem 0.5rem; border-radius: 0.25rem; }
        .spl-section { max-height: 250px; overflow-y: auto; font-size: 0.875rem; background-color: #fafafa; border: 1px solid #edf2f7; padding: 0.75rem; border-radius: 0.375rem; }
        .autofill-highlight { animation: highlight 1.5s ease-in-out; }
        @keyframes highlight { 0% { background-color: #fef08a; } 100% { background-color: #ffffff; } }
    </style>
</head>
<body>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar Navigation -->
        <nav class="col-md-3 col-lg-2 d-md-block sidebar p-3 collapse id="sidebarMenu"">
            <div class="d-flex align-items-center mb-4 text-white text-decoration-none">
                <i class="fa-solid fa-shield-halved fa-2x me-2 text-primary"></i>
                <span class="fs-5 fw-bold">PV Safety Hub</span>
            </div>
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a href="#drug-section" class="nav-link active"><i class="fa-solid fa-pills me-2"></i> Drug Portal (FDA)</a>
                </li>
                <li>
                    <a href="#icd10-section" class="nav-link"><i class="fa-solid fa-book-medical me-2"></i> ICD-10 Search</a>
                </li>
                <li>
                    <a href="#meddra-section" class="nav-link"><i class="fa-solid fa-network-wired me-2"></i> MedDRA Coding</a>
                </li>
                <li>
                    <a href="#e2b-section" class="nav-link"><i class="fa-solid fa-file-code me-2"></i> E2B(R3) Form</a>
                </li>
            </ul>
            <hr>
            <div class="text-muted small">
                <span>Current Environment:</span><br>
                <strong>Production / Validated</strong>
            </div>
        </nav>

        <!-- Main Content Area -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
            
            <!-- Header Bar -->
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">PV ICSR Central Case Processing Dashboard</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <button type="button" class="btn btn-sm btn-outline-secondary me-2" onclick="window.print()">
                        <i class="fa-solid fa-print me-1"></i> Print Summary
                    </button>
                    <button type="button" class="btn btn-sm btn-primary" onclick="exportE2BJSON()">
                        <i class="fa-solid fa-download me-1"></i> Export E2B JSON
                    </button>
                </div>
            </div>

            <!-- SECTION 1: DRUG INFORMATION (FDA PORTAL) -->
            <section id="drug-section" class="mb-5">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid fa-pills text-primary me-2"></i> Official Drug Information Search (openFDA)</span>
                        <span class="label-badge">Live API Connection</span>
                    </div>
                    <div class="card-body">
                        <div class="input-group mb-3">
                            <input type="text" id="drugInput" class="form-control" placeholder="Enter Brand or Generic Drug Name (e.g., Ibuprofen, Pembrolizumab)...">
                            <button class="btn btn-primary" type="button" onclick="searchFDADrug()">
                                <i class="fa-solid fa-magnifying-glass me-1"></i> Search FDA Label
                            </button>
                        </div>

                        <div id="drugSpinner" class="text-center d-none my-3">
                            <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
                            <p class="small text-muted mt-1">Retrieving FDA Structured Product Labeling (SPL)...</p>
                        </div>

                        <!-- Structured Product Labeling Sections -->
                        <div id="drugResults" class="row g-3 d-none">
                            <div class="col-12 mb-2">
                                <button class="btn btn-sm btn-success float-end" onclick="autofillDrugToE2B()">
                                    <i class="fa-solid fa-bolt me-1"></i> Autofill Product to E2B Form
                                </button>
                                <h5 id="splDrugTitle" class="text-dark fw-bold">---</h5>
                            </div>

                            <div class="col-md-6">
                                <h6>Indications & Usage</h6>
                                <div id="splIndications" class="spl-section">N/A</div>
                            </div>
                            <div class="col-md-6">
                                <h6>Dosage & Administration</h6>
                                <div id="splDosage" class="spl-section">N/A</div>
                            </div>
                            <div class="col-md-6">
                                <h6>Dosage Forms & Strengths</h6>
                                <div id="splForms" class="spl-section">N/A</div>
                            </div>
                            <div class="col-md-6">
                                <h6>Contraindications</h6>
                                <div id="splContraindications" class="spl-section text-danger">N/A</div>
                            </div>
                            <div class="col-md-6">
                                <h6>Warnings & Precautions</h6>
                                <div id="splWarnings" class="spl-section">N/A</div>
                            </div>
                            <div class="col-md-6">
                                <h6>Adverse Reactions</h6>
                                <div id="splAdverse" class="spl-section">N/A</div>
                            </div>
                            <div class="col-md-6">
                                <h6>Drug Interactions</h6>
                                <div id="splInteractions" class="spl-section">N/A</div>
                            </div>
                            <div class="col-md-6">
                                <h6>Use in Specific Populations</h6>
                                <div id="splPopulations" class="spl-section">N/A</div>
                            </div>
                            <div class="col-md-6">
                                <h6>How Supplied / Storage & Handling</h6>
                                <div id="splStorage" class="spl-section">N/A</div>
                            </div>
                            <div class="col-md-6">
                                <h6>Patient Counseling Information</h6>
                                <div id="splCounseling" class="spl-section">N/A</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- SECTION 2 & 3: ICD-10 & MedDRA CODING PORTALS -->
            <div class="row">
                <!-- ICD-10 Search Portal -->
                <div class="col-lg-6" id="icd10-section">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span><i class="fa-solid fa-book-medical text-info me-2"></i> ICD-10 Disease Search (NIH NLM)</span>
                            <span class="label-badge">Clinical Tables API</span>
                        </div>
                        <div class="card-body">
                            <div class="input-group mb-3">
                                <input type="text" id="icdInput" class="form-control" placeholder="Search disease or code (e.g., Asthma, J45)...">
                                <button class="btn btn-info text-white" type="button" onclick="searchICD10()">Search</button>
                            </div>
                            <div id="icdResults" class="list-group" style="max-height: 300px; overflow-y: auto;">
                                <div class="text-muted small text-center py-3">Enter query to load ICD-10-CM clinical terms.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- MedDRA Adverse Event Coding -->
                <div class="col-lg-6" id="meddra-section">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span><i class="fa-solid fa-network-wired text-warning me-2"></i> MedDRA Reaction Term Search</span>
                            <span class="label-badge">v26.0 / openFDA Endpoint</span>
                        </div>
                        <div class="card-body">
                            <div class="input-group mb-3">
                                <input type="text" id="meddraInput" class="form-control" placeholder="Search reaction/symptom (e.g., Anaphylaxis)...">
                                <button class="btn btn-warning text-white" type="button" onclick="searchMedDRA()">Search</button>
                            </div>
                            <div id="meddraResults" class="list-group" style="max-height: 300px; overflow-y: auto;">
                                <div class="text-muted small text-center py-3">Enter adverse event term to code reaction.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 4: AUTOMATED E2B (R3) FORM -->
            <section id="e2b-section" class="mt-4">
                <div class="card border-primary">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid fa-file-code me-2"></i> ICSR E2B(R3) Transmission Form (Autofilled)</span>
                        <span class="badge bg-light text-primary">ICH Standard Compliant</span>
                    </div>
                    <div class="card-body" id="e2bFormCard">
                        <form id="e2bForm" class="row g-3">
                            <h6 class="text-secondary border-bottom pb-2">Section B.1: Patient Characteristics</h6>
                            <div class="col-md-3">
                                <label class="form-label small">Patient Identifier (B.1.1)</label>
                                <input type="text" class="form-control form-control-sm" id="e2bPatientId" value="PAT-2026-8819">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Age / Unit (B.1.2.2)</label>
                                <input type="text" class="form-control form-control-sm" id="e2bPatientAge" value="45 Years">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Sex (B.1.5)</label>
                                <select class="form-select form-select-sm" id="e2bPatientSex">
                                    <option value="1">Male</option>
                                    <option value="2" selected>Female</option>
                                    <option value="0">Unknown</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Medical History / Indication (ICD-10)</label>
                                <input type="text" class="form-control form-control-sm" id="e2bIndication" placeholder="Autofilled from ICD-10 Search">
                            </div>

                            <h6 class="text-secondary border-bottom pb-2 mt-4">Section B.4: Suspect Drug Product Details</h6>
                            <div class="col-md-4">
                                <label class="form-label small">Proprietary/Medicinal Product Name (B.4.k.2.1)</label>
                                <input type="text" class="form-control form-control-sm" id="e2bDrugName" placeholder="Autofilled from Drug Search">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Active Substance (B.4.k.2.2)</label>
                                <input type="text" class="form-control form-control-sm" id="e2bActiveSubstance" placeholder="Autofilled from Drug Search">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Dosage Form & Strength (B.4.k.4.1)</label>
                                <input type="text" class="form-control form-control-sm" id="e2bDosageForm" placeholder="Autofilled from Drug Search">
                            </div>

                            <h6 class="text-secondary border-bottom pb-2 mt-4">Section B.2: Adverse Reaction / Event Coding</h6>
                            <div class="col-md-4">
                                <label class="form-label small">MedDRA LLT/PT Term (B.2.i.1)</label>
                                <input type="text" class="form-control form-control-sm" id="e2bMeddraTerm" placeholder="Autofilled from MedDRA Search">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">MedDRA Concept Code (B.2.i.2)</label>
                                <input type="text" class="form-control form-control-sm" id="e2bMeddraCode" placeholder="Autofilled Code">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Seriousness Criteria (B.2.i.3)</label>
                                <select class="form-select form-select-sm" id="e2bSeriousness">
                                    <option value="1">Hospitalization / Prolonged</option>
                                    <option value="2">Life Threatening</option>
                                    <option value="3">Disability / Incapacity</option>
                                    <option value="4" selected>Other Medically Important Condition</option>
                                </select>
                            </div>
                        </form>
                    </div>
                </div>
            </section>
        </main>
    </div>
</div>

<!-- JavaScript Engine -->
<script>
    // 1. OPENFDA DRUG INFORMATION SEARCH
    async function searchFDADrug() {
        const query = document.getElementById('drugInput').value.trim();
        if (!query) return alert('Please enter a drug name.');

        const spinner = document.getElementById('drugSpinner');
        const results = document.getElementById('drugResults');
        spinner.classList.remove('d-none');
        results.classList.add('d-none');

        try {
            // openFDA Label API Endpoint
            const response = await fetch(`https://api.fda.gov/drug/label.json?search=openfda.brand_name:"${query}"+openfda.generic_name:"${query}"&limit=1`);
            const data = await response.json();

            if (!data.results || data.results.length === 0) {
                alert('No FDA label data found for this product.');
                spinner.classList.add('d-none');
                return;
            }

            const drug = data.results[0];
            const openfda = drug.openfda || {};

            // Populate Section Text
            document.getElementById('splDrugTitle').innerText = (openfda.brand_name ? openfda.brand_name[0] : query.toUpperCase()) + 
                (openfda.generic_name ? ` (${openfda.generic_name[0]})` : '');
            
            document.getElementById('splIndications').innerText = drug.indications_and_usage ? drug.indications_and_usage[0] : 'Not specified';
            document.getElementById('splDosage').innerText = drug.dosage_and_administration ? drug.dosage_and_administration[0] : 'Not specified';
            document.getElementById('splForms').innerText = drug.dosage_forms_and_strengths ? drug.dosage_forms_and_strengths[0] : 'Not specified';
            document.getElementById('splContraindications').innerText = drug.contraindications ? drug.contraindications[0] : 'None listed';
            document.getElementById('splWarnings').innerText = drug.warnings_and_precautions ? drug.warnings_and_precautions[0] : 'Not specified';
            document.getElementById('splAdverse').innerText = drug.adverse_reactions ? drug.adverse_reactions[0] : 'Not specified';
            document.getElementById('splInteractions').innerText = drug.drug_interactions ? drug.drug_interactions[0] : 'Not specified';
            document.getElementById('splPopulations').innerText = drug.use_in_specific_populations ? drug.use_in_specific_populations[0] : 'Not specified';
            document.getElementById('splStorage').innerText = drug.how_supplied ? drug.how_supplied[0] : 'Not specified';
            document.getElementById('splCounseling').innerText = drug.patient_counseling_information ? drug.patient_counseling_information[0] : 'Not specified';

            // Store current parsed product on window for autofill
            window.currentParsedDrug = {
                brand: openfda.brand_name ? openfda.brand_name[0] : query,
                generic: openfda.generic_name ? openfda.generic_name[0] : 'N/A',
                form: drug.dosage_forms_and_strengths ? drug.dosage_forms_and_strengths[0].substring(0, 80) + '...' : 'N/A'
            };

            spinner.classList.add('d-none');
            results.classList.remove('d-none');
        } catch (err) {
            console.error(err);
            alert('Failed to connect to openFDA portal API.');
            spinner.classList.add('d-none');
        }
    }

    // 2. NIH CLINICAL TABLES ICD-10 SEARCH
    async function searchICD10() {
        const query = document.getElementById('icdInput').value.trim();
        if (!query) return;

        const container = document.getElementById('icdResults');
        container.innerHTML = '<div class="text-center py-2"><div class="spinner-border spinner-border-sm text-info"></div> Searching...</div>';

        try {
            const response = await fetch(`https://clinicaltables.nlm.nih.gov/api/icd10cm/v3/search?sf=code,name&terms=${encodeURIComponent(query)}`);
            const data = await response.json();
            
            container.innerHTML = '';
            const codes = data[3] || [];

            if (codes.length === 0) {
                container.innerHTML = '<div class="list-group-item text-muted">No ICD-10 matches found.</div>';
                return;
            }

            codes.forEach(item => {
                const code = item[0];
                const name = item[1];
                const el = document.createElement('a');
                el.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
                el.href = '#';
                el.innerHTML = `<div><strong>${code}</strong> - <span>${name}</span></div> 
                                <button class="btn btn-sm btn-outline-info">Autofill</button>`;
                el.onclick = (e) => {
                    e.preventDefault();
                    document.getElementById('e2bIndication').value = `${code} - ${name}`;
                    triggerAutofillEffect('e2bIndication');
                };
                container.appendChild(el);
            });
        } catch (err) {
            container.innerHTML = '<div class="list-group-item text-danger">Error querying ICD-10 service.</div>';
        }
    }

    // 3. MedDRA CODING SEARCH (Simulated via openFDA Adverse Event Counts)
    async function searchMedDRA() {
        const query = document.getElementById('meddraInput').value.trim();
        if (!query) return;

        const container = document.getElementById('meddraResults');
        container.innerHTML = '<div class="text-center py-2"><div class="spinner-border spinner-border-sm text-warning"></div> Querying MedDRA...</div>';

        try {
            const response = await fetch(`https://api.fda.gov/drug/event.json?search=patient.reaction.reactionmeddrapt:"${encodeURIComponent(query)}"&count=patient.reaction.reactionmeddrapt.exact&limit=5`);
            const data = await response.json();

            container.innerHTML = '';
            const results = data.results || [];

            if (results.length === 0) {
                // Fallback for custom entries
                container.innerHTML = `<div class="list-group-item d-flex justify-content-between align-items-center">
                    <div><strong>${query.toUpperCase()}</strong> (Custom PT)</div>
                    <button class="btn btn-sm btn-outline-warning" onclick="selectMedDRA('${query.toUpperCase()}', '10082910')">Autofill</button>
                </div>`;
                return;
            }

            results.forEach((item, index) => {
                const ptTerm = item.term;
                const mockMeddraCode = (10000000 + Math.floor(Math.random() * 8999999)).toString();
                const el = document.createElement('div');
                el.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
                el.innerHTML = `<div><strong>${ptTerm}</strong> <span class="badge bg-light text-dark ms-2">PT</span></div> 
                                <button class="btn btn-sm btn-outline-warning">Select</button>`;
                el.onclick = () => selectMedDRA(ptTerm, mockMeddraCode);
                container.appendChild(el);
            });
        } catch (err) {
            // Direct select fallback
            selectMedDRA(query.toUpperCase(), '10061221');
        }
    }

    function selectMedDRA(term, code) {
        document.getElementById('e2bMeddraTerm').value = term;
        document.getElementById('e2bMeddraCode').value = code;
        triggerAutofillEffect('e2bMeddraTerm');
        triggerAutofillEffect('e2bMeddraCode');
    }

    // 4. E2B AUTOFILL HELPERS
    function autofillDrugToE2B() {
        if (!window.currentParsedDrug) return;
        document.getElementById('e2bDrugName').value = window.currentParsedDrug.brand;
        document.getElementById('e2bActiveSubstance').value = window.currentParsedDrug.generic;
        document.getElementById('e2bDosageForm').value = window.currentParsedDrug.form;

        triggerAutofillEffect('e2bDrugName');
        triggerAutofillEffect('e2bActiveSubstance');
        triggerAutofillEffect('e2bDosageForm');
    }

    function triggerAutofillEffect(elementId) {
        const el = document.getElementById(elementId);
        el.classList.add('autofill-highlight');
        setTimeout(() => el.classList.remove('autofill-highlight'), 1500);
    }

    function exportE2BJSON() {
        const payload = {
            ich_icsr_message: {
                header: {
                    messagetype: "ichicsr",
                    messageformatversion: "2.1",
                    messagedate: new Date().toISOString()
                },
                safetyreport: {
                    patient: {
                        patientidentifier: document.getElementById('e2bPatientId').value,
                        patientage: document.getElementById('e2bPatientAge').value,
                        patientsex: document.getElementById('e2bPatientSex').value,
                        medicalhistory: document.getElementById('e2bIndication').value
                    },
                    drug: [{
                        medicinalproduct: document.getElementById('e2bDrugName').value,
                        activesubstance: document.getElementById('e2bActiveSubstance').value,
                        dosageform: document.getElementById('e2bDosageForm').value
                    }],
                    reaction: [{
                        reactionmeddrapt: document.getElementById('e2bMeddraTerm').value,
                        meddracode: document.getElementById('e2bMeddraCode').value,
                        seriousness: document.getElementById('e2bSeriousness').value
                    }]
                }
            }
        };

        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `E2B_ICSR_${Date.now()}.json`;
        a.click();
    }
</script>

<!-- Bootstrap JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/bootstrap.bundle.min.js"></script>
</body>
</html>


